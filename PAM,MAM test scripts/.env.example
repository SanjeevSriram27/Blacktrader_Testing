# ==============================================================================
# BLACKTRADER SOCIAL TRADING QUALITY PLATFORM (PAMM & MAM AUTOMATION)
# ==============================================================================
# Copy this file to '.env' and enter your test account credentials.
# '.env' is automatically gitignored to protect sensitive credentials.

# Target Platform Base URL
PLATFORM_BASE_URL=https://lpadmin.blackfx.com

# ------------------------------------------------------------------------------
# 1. PAMM SUITE - REAL (HEDGING) ACCOUNTS
# ------------------------------------------------------------------------------
# PAMM Master Account created with "Real (Hedging)"
PAMM_HEDGING_MASTER_EMAIL=
PAMM_HEDGING_MASTER_PASSWORD=
PAMM_HEDGING_POOL_NAME=Alpha Hedging Pool
PAMM_HEDGING_MANAGER_SHARE_PERCENT=20

# PAMM Follower Account created with "Real (Hedging)"
PAMM_HEDGING_FOLLOWER_EMAIL=
PAMM_HEDGING_FOLLOWER_PASSWORD=

# ------------------------------------------------------------------------------
# 2. PAMM SUITE - REAL (NETTING) ACCOUNTS
# ------------------------------------------------------------------------------
# PAMM Master Account created with "Real (Netting)"
PAMM_NETTING_MASTER_EMAIL=
PAMM_NETTING_MASTER_PASSWORD=
PAMM_NETTING_POOL_NAME=Alpha Netting Pool
PAMM_NETTING_MANAGER_SHARE_PERCENT=20

# PAMM Follower Account created with "Real (Netting)"
PAMM_NETTING_FOLLOWER_EMAIL=
PAMM_NETTING_FOLLOWER_PASSWORD=

# ------------------------------------------------------------------------------
# 3. MAM SUITE - (FOR FUTURE MAM EXPANSION)
# ------------------------------------------------------------------------------
# MAM Master Account (Hedging / Netting)
MAM_MASTER_EMAIL=
MAM_MASTER_PASSWORD=
MAM_ALLOCATION_METHOD=LOT_RATIO  # LOT_RATIO, PERCENTAGE, or EQUITY_RATIO

# MAM Sub-Accounts / Followers
MAM_FOLLOWER_1_EMAIL=
MAM_FOLLOWER_1_PASSWORD=
MAM_FOLLOWER_2_EMAIL=
MAM_FOLLOWER_2_PASSWORD=

# ------------------------------------------------------------------------------
# 4. BACKOFFICE ADMIN (Optional - for platform-level audit tests)
# ------------------------------------------------------------------------------
BLACKADMIN_EMAIL=lpadmin@blacktrader.com
BLACKADMIN_PASSWORD=Raj1234!

# ------------------------------------------------------------------------------
# 5. GLOBAL SUITE SETTINGS
# ------------------------------------------------------------------------------
DEFAULT_SYMBOL=EURUSD
TEST_FOLLOWER_COUNT=100
MAX_CONCURRENT_THREADS=25
